# =============================================================================
# Symba engine — environment template
# -----------------------------------------------------------------------------
# Copy to .env for local dev (.env is gitignored). Settings load from symba.toml
# and are overridden by these env vars: prefix SYMBA_, nested keys use double
# underscore. Example: [postgres].dsn -> SYMBA_POSTGRES__DSN
# =============================================================================

# ----- Application ([app]) -----
SYMBA_APP__NAME=symba
# Routed deployments set production; startup then rejects auth mode none or
# token mode without a non-empty shared secret/JWKS verifier.
SYMBA_APP__ENVIRONMENT=development
SYMBA_APP__VERSION_MAJOR=0
SYMBA_APP__VERSION_MINOR=1
SYMBA_APP__VERSION_PATCH=0

# Coordinated bundle provenance used only by Docker builds. The production
# overlay requires reviewed values from the parent release manifest.
KNOR_RELEASE_ID=development
KNOR_RELEASE_MANIFEST_SHA256=unreleased

# ----- Transports ([server]) -----
SYMBA_SERVER__GRPC_PORT=7233
SYMBA_SERVER__HTTP_PORT=7300
# SYMBA_SERVER__ROLES=all
# Production requires a server certificate whose SAN covers the exact
# grpcs:// authority used by every client. Mount runtime files read-only.
SYMBA_SERVER__GRPC_TLS_ENABLED=false
# SYMBA_SERVER__GRPC_TLS_CERT_FILE=/run/secrets/symba/server.crt
# SYMBA_SERVER__GRPC_TLS_KEY_FILE=/run/secrets/symba/server.key
# SYMBA_SERVER__GRPC_TLS_CLIENT_CA_FILE=/run/secrets/symba/client-ca.crt
# SYMBA_SERVER__GRPC_TLS_REQUIRE_CLIENT_AUTH=false

# ----- Database ([postgres]) — schema is Flyway-managed -----
# Discrete fields safely encode reserved characters in credentials. A legacy
# SYMBA_POSTGRES__DSN remains supported when none of these fields are set.
SYMBA_POSTGRES__HOST=localhost
SYMBA_POSTGRES__PORT=5432
SYMBA_POSTGRES__USER=symba
SYMBA_POSTGRES__PASSWORD=symba
SYMBA_POSTGRES__DATABASE=symba
SYMBA_POSTGRES__SCHEMA_NAME=symba
# SYMBA_POSTGRES__HOT_POOL_SIZE=20
# SYMBA_POSTGRES__GENERAL_POOL_SIZE=20

# ----- Redis ([redis]) — empty = degraded mode -----
SYMBA_REDIS__URL=
# SYMBA_REDIS__URL=redis://localhost:6379/0
# Production Compose requires an independent URL-safe secret of at least 32
# characters and constructs the authenticated in-network URL itself.
# SYMBA_REDIS_PASSWORD=

# ----- Auth ([auth]) -----
# Bare-metal default is loopback-only none mode. Production requires token or
# mtls; compose reads the SYMBA_AUTH_MODE alias in the docker-compose section.
SYMBA_AUTH__MODE=none
# SYMBA_AUTH__TOKEN_JWKS_URL=
# Shared-secret -> tenant map for token mode (JSON). The SPA login page accepts one of
# these secrets and stores it as the operator session; workers send it as Bearer.
# SYMBA_AUTH__TOKENS={"change-me-secret":"default"}
# mode=none is loopback-only UNLESS the peer is in a trusted CIDR. The SPA's nginx proxy
# makes the engine see the proxy's container IP (not 127.0.0.1), so behind the compose
# stack you must trust the internal Docker subnet for none-mode to work. JSON list.
# NEVER put a public range here. Prod should use token/mtls instead of widening this.
# SYMBA_AUTH__TRUSTED_PROXY_CIDRS=["172.31.0.0/24"]

# ----- Logging ([log]) -----
SYMBA_LOG__LEVEL=INFO
SYMBA_LOG__ENABLE_STDOUT=true
# SYMBA_LOG__FILE_PATH=/var/log/app/symba.log

# ----- Observability ([observability]) -----
SYMBA_OBSERVABILITY__METRICS_ENABLED=true
# SYMBA_OBSERVABILITY__OTLP_ENDPOINT=http://localhost:4317

# ----- Flyway / Postgres container credentials (docker-compose only) -----
POSTGRES_DB=symba
POSTGRES_USER=symba
POSTGRES_PASSWORD=symba
# Production Compose replaces the development account with three fixed roles.
# Generate each password independently; every value must be at least 32 chars.
# SYMBA_POSTGRES_ADMIN_PASSWORD=
# SYMBA_POSTGRES_MIGRATION_PASSWORD=
# SYMBA_POSTGRES_RUNTIME_PASSWORD=

# Auth interpolation used by docker-compose.yml. A production deployment sets
# token and a non-empty URL-safe secret; the engine no longer has a known
# fallback credential.
SYMBA_AUTH_MODE=none
# SYMBA_DEV_TOKEN=

# ----- docker-compose host bindings and port remaps (docker-compose only) -----
# PostgreSQL and Redis default to loopback because only local containers and
# operators need their host ports. Engine/UI also default to loopback for safe
# local development; set SYMBA_GRPC_BIND_ADDRESS to a private interface such as a
# Tailscale address when remote workers must connect. Browser/operator HTTP
# remains loopback-only behind Tailscale Serve HTTPS. In-network ports stay fixed.
SYMBA_INTERNAL_BIND_ADDRESS=127.0.0.1
SYMBA_GRPC_BIND_ADDRESS=127.0.0.1
SYMBA_HTTP_BIND_ADDRESS=127.0.0.1
POSTGRES_HOST_PORT=5440
REDIS_HOST_PORT=6377
ENGINE_GRPC_HOST_PORT=7233
ENGINE_HTTP_HOST_PORT=7300
UI_HOST_PORT=8090

# Production-only host paths consumed by docker-compose.production.yml.
# SYMBA_GRPC_TLS_CERT_FILE_HOST=/etc/symba/tls/server.crt
# SYMBA_GRPC_TLS_KEY_FILE_HOST=/etc/symba/tls/server.key
# SYMBA_GRPC_TLS_CA_FILE_HOST=/etc/symba/tls/ca.crt
# Exact identity and immutable certificate policy enforced before any service
# with persistent state starts. Fingerprints are SHA-256 hex, with or without
# colon separators. Keep at least one day of certificate validity at admission.
# SYMBA_GRPC_TLS_EXPECTED_DNS_NAME=studioproduct-4.example.ts.net
# SYMBA_GRPC_TLS_EXPECTED_IP=100.64.0.4
# SYMBA_GRPC_TLS_EXPECTED_CERT_SHA256=
# SYMBA_GRPC_TLS_EXPECTED_CA_SHA256=
# SYMBA_GRPC_TLS_MIN_REMAINING_SECONDS=86400
